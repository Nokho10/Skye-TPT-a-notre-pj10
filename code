Le code pour le joueur :
Ce code permet au joueur de pouvoir aller a gauche et a droite et de pouvoir sauter, pour l'instant les animations de marche et de idle sont presentes
de plus, le code dispose aussi d'un système de bar de vie mais juste graphique pas encore fonctionnel.

-----------------------------------------------------------------------
Create :


// ============================================================
// MOUVEMENT (ton code)
// ============================================================
hsp = 0;         // vitesse horizontale
vsp = 0;         // vitesse verticale

walk_speed = 4;   // vitesse de marche
grav = 0.5;       // gravité
jump_power = -10; // force de saut
facing = 1; // 1 = droite, -1 = gauche
max_hp = 100;
hp = max_hp;
// ============================================================
// SPRITESHEET (un seul sprite avec toutes les frames)
// ============================================================
sprite_index = spr_player_run_r; // ton spritesheet découpé dans GMS
image_speed = 0;                 // on contrôle l'animation à la main
image_index = 0;



-----------------------------------------------------------------------


Step :


// ============================================================
// MOUVEMENT HORIZONTAL
// ============================================================
hsp = 0;

if (keyboard_check(ord("Q"))) {
    hsp = -walk_speed;
}
if (keyboard_check(ord("D"))) {
    hsp = walk_speed;
}

if (place_meeting(x + hsp, y, obj_sol)) {
    while (!place_meeting(x + sign(hsp), y, obj_sol)) {
        x += sign(hsp);
    }
    hsp = 0;
}
x += hsp;

// ============================================================
// GRAVITÉ + SAUT
// ============================================================
vsp += grav;

if (keyboard_check_pressed(vk_space)) {
    if (place_meeting(x, y + 1, obj_sol)) {
        vsp = jump_power;
    }
}

if (place_meeting(x, y + vsp, obj_sol)) {
    while (!place_meeting(x, y + sign(vsp), obj_sol)) {
        y += sign(vsp);
    }
    vsp = 0;
} else {
    y += vsp;
}

if (keyboard_check_pressed(ord("H")))
{
    hp -= 10;
}

if (hp < 0)
{
    hp = 0;
}

// ============================================================
// ANIMATIONS RUN / IDLE GAUCHE-DROITE
// ============================================================

// Vitesse d'animation (à ajuster)
image_speed = 2;

// Si on bouge
if (hsp != 0) {
    if (hsp > 0) {
        facing = 1;
        if (sprite_index != spr_player_run_r) {
            sprite_index = spr_player_run_r;
            image_index = 0;
        }
    } else {
        facing = -1;
        if (sprite_index != spr_player_run_l) {
            sprite_index = spr_player_run_l;
            image_index = 0;
        }
    }
}
// Si on ne bouge pas → IDLE selon la dernière direction
else {
    image_speed = 0.5; // idle peut être animé si tu veux
    if (facing == 1) {
        if (sprite_index != spr_player_idle_r) {
            sprite_index = spr_player_idle_r;
            image_index = 0;
        }
    } else {
        if (sprite_index != spr_player_idle_l) {
            sprite_index = spr_player_idle_l;
            image_index = 0;
        }
    }
}
